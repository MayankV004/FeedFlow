<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts APP</title>
    <!-- <link href="/css/tailwind.css" rel="stylesheet"> -->
    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a class="inline-block px-3 py-2 text-center mb-5 bg-green-600 w-28 rounded-md" href="/">Register</a>
        </div>
        <h1 class="text-center text-4xl font-serif font-semibold">Login</h1>
        <form action="/login" method="post" class="flex flex-col gap-3 justify-center items-center mt-10">
            <input class="w-1/4 px-3 py-2 outline-none bg-transparent border-2 border-zinc-800 rounded-md" type="email"
                placeholder="email" name="email">
            <input class="w-1/4 px-3 py-2 outline-none bg-transparent border-2 border-zinc-800 rounded-md"
                type="password" placeholder="password" name="password">

            <input class="w-1/4 px-3 py-2 bg-blue-500 rounded-md cursor-pointer hover:bg-blue-800" type="submit"
                value="Login">
        </form>
    </div>

</body>

</html>