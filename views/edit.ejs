<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts APP</title>
    <!-- <link href="/css/tailwind.css" rel="stylesheet"> -->
    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body>
    <main>


        <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
            <div class="w-full flex justify-end">

                <a class="bg-red-600 rounded-md  text-sm px-3 py-2 inline-block mb-5" href="/logout">Logout</a>
            </div>
           
            <h5 class="mb-5">Edit your Post</h5>
            <form action="/update/<%= post._id  %>" method="post">
                <textarea name="postData" id=""
                    class="p-3 w-1/3 block resize-none bg-transparent outline-none border-2 border-zinc-800 rounded-md"
                    placeholder="What's on your Mind ?"><%= post.content %></textarea>
                <input type="submit" class="px-3 py-2 bg-yellow-500 rounded-md mt-4 block w-40 text-sm"
                    value="Update Post">
            </form>
           
        </div>
    </main>
</body>

</html>