<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts APP</title>
    <!-- <link href="/css/tailwind.css" rel="stylesheet"> -->
    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a class="inline-block px-3 py-2 text-center mb-5 bg-pink-600 w-20 rounded-md"href="/profile">profile</a>
        </div>
        <h1 class="text-center text-4xl font-serif font-semibold">Upload profile</h1>
        <form action="/upload" method="post" enctype="multipart/form-data" class="flex flex-col gap-3 justify-center items-center mt-10">
            <input name="image" class="block w-1/4 text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400" aria-describedby="file_input_help" id="file_input" type="file">
            
            <input class="w-1/4 px-3 py-2 bg-blue-500 rounded-md cursor-pointer hover:bg-blue-800" type="submit" value="Upload">
        </form>
    </div>

</body>

</html>