<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts APP</title>
    <!-- <link href="/css/tailwind.css" rel="stylesheet"> -->
    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body>
    <main>


        <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
            <div class="w-full flex justify-end">

                <a class="bg-red-600 rounded-md  text-sm px-3 py-2 inline-block mb-5" href="/logout">Logout</a>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-8 h-8  rounded-full overflow-hidden"><img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilePic  %>" alt=""></div>
                <h1 class="text-3xl font-serif font-semibold"> <span class="font-light">Hello , <%= user.name %></span></h1>
            </div>
            <h5 class="mb-5">You can Create a new Post</h5>
            <form action="/post" method="post">
                <textarea name="postData" id=""
                    class="p-3 w-1/3 block resize-none bg-transparent outline-none border-2 border-zinc-800 rounded-md"
                    placeholder="What's on your Mind ?"></textarea>
                <input type="submit" class="px-3 py-2 bg-blue-500 rounded-md mt-4 block w-40 text-sm"
                    value="Create New Post">
            </form>
            <div class="posts mt-20">
                <h3 class="text-zinc-400">Your Posts. </h3>
                <div class="postContainer mt-5">
                    <% user.posts.reverse().forEach(post=> { %>
                        <div class="post mb-4 w-1/3 p-3 border-[1px] border-zinc-800 rounded-md bg-zinc-800">
                            <h4 class="text-blue-500"> @ <%= user.username %>
                            </h4>
                            <p class="text-sm tracking-tight">
                                <%= post.content %>
                            </p>
                            <small class="mt-2 inline-block">
                                <%= post.likes.length %> likes
                            </small>
                            <div class="btns flex gap-10 mt-1">

                                <a class="text-blue-600" href="/like/<%= post._id  %>">
                                    <%= post.likes.indexOf(user._id)===-1 ? "Like" : "Unlike" %>
                                </a>

                                <a class="text-zinc-500" href="/edit/<%= post._id  %>">Edit</a>
                            </div>
                        </div>
                        <% }); %>

                </div>
            </div>
        </div>
    </main>
</body>

</html>